{
  "name": "amberbeam",
  "version": "0.1.2",
  "description": "Dual-pane FTP, FTPS and SFTP client for macOS, Windows and Linux — keyboard-driven, with a persistent transfer queue and mid-file resume.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/sphings79/amberbeam.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:lang": "node scripts/check-lang.mjs",
    "check:seams": "node scripts/check-seams.mjs",
    "verify": "npm run check:lang && npm run check:seams && npm run check:keys && npm run check:docs && npm run check",
    "tauri": "tauri",
    "check:keys": "node scripts/check-keys.mjs",
    "check:docs": "node scripts/check-docs.mjs"
  },
  "dependencies": {
    "@tanstack/virtual-core": "^3.17.10",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.7.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/node": "^22.20.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
