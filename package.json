  "description": "Dual-pane FTP and SFTP client for macOS, built for people coming from Windows who miss FlashFXP.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/sphings79/amberbeam.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
